# Released condition-gene associations and source pages for STXBP1.
PREFIX ra: <https://w3id.org/rare-disease-atlas/vocab#>
PREFIX raid: <https://w3id.org/rare-disease-atlas/id/>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT DISTINCT ?condition ?identifier ?source WHERE {
    ?condition ra:has_associated_gene raid:HGNC%3A11444 ;
               dcterms:identifier ?identifier ;
               dcterms:source ?source .
}
